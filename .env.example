# ── 배포 주소 ────────────────────────────────────────────────────────────
# canonical / sitemap / OG URL 이 전부 이 값에서 나옵니다. 반드시 실제 주소로.
#   커스텀 도메인:             https://내도메인.kr
#   username.github.io 저장소: https://username.github.io
#   프로젝트 저장소:           https://username.github.io  (+ 아래 BASE_PATH)
NEXT_PUBLIC_SITE_URL=https://username.github.io

# 프로젝트 저장소(https://username.github.io/저장소명)로 배포할 때만 채웁니다.
# 커스텀 도메인이나 username.github.io 저장소면 비워두세요.
NEXT_PUBLIC_BASE_PATH=

# ── 애드센스 (승인 후) ───────────────────────────────────────────────────
# 비워두면 광고 스크립트도, 빈 광고 자리도, ads.txt 도 만들어지지 않습니다.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_AD_SLOT_TOP=
NEXT_PUBLIC_AD_SLOT_MID=

# ── 분석 도구 (선택) ─────────────────────────────────────────────────────
# 구글 서치콘솔 소유권 확인 메타태그의 content 값만
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# GA4 측정 ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
